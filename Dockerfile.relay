FROM node:20-alpine

WORKDIR /app

# Copy package descriptors
COPY package*.json ./

# Install production dependencies only
RUN npm install --omit=dev

# Copy relay service script
COPY scripts/fef-remote-relay-service.js ./scripts/

# Default environment
ENV NODE_ENV=production
ENV PORT=5557
ENV RELAY_HOST=0.0.0.0

EXPOSE 5557

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:5557/health || exit 1

# Start hardened relay
CMD ["node", "scripts/fef-remote-relay-service.js"]
