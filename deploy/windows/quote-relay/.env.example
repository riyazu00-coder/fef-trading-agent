# Copy this file to .env and replace every placeholder locally.
# Never commit the populated .env file.
FEF_QUOTE_RELAY_URL=https://<approved-relay-host>/api/relay/quotes
FEF_QUOTE_RELAY_SECRET=<unique-high-entropy-quote-relay-secret>
FEF_QUOTE_SOURCE_FILE=C:\Users\<User>\AppData\Roaming\MetaQuotes\Terminal\Common\Files\fef_mt5_quote_snapshot.json
FEF_QUOTE_PUBLISH_INTERVAL_SECONDS=2

# Optional read-only dashboard endpoint used by health-check.ps1.
FEF_QUOTE_STATUS_URL=https://<approved-dashboard-host>/api/status
